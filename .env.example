# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mollie
MOLLIE_API_KEY=your-mollie-api-key

# WooCommerce
NEXT_PUBLIC_WOOCOMMERCE_URL=https://admin.bikerfun.nl
WOOCOMMERCE_CONSUMER_KEY=your-woocommerce-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-woocommerce-consumer-secret

# App URL
NEXT_PUBLIC_APP_URL=https://bikerfun.nl

# StackMail SMTP (Email) - Voor verzenden vanaf server
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bikerfun.nl
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=info@bikerfun.nl
SMTP_TO_EMAIL=info@bikerfun.nl

# Vercel Cron Security
CRON_SECRET=generate-random-string-here

# Upstash Redis (Optional - voor rate limiting)
# Als je rate limiting wilt activeren, maak een gratis account op https://upstash.com
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
