# ⚠️ BELANGRIJK: Kopieer dit bestand naar .env.local en vul je eigen credentials in!

# Supabase - Haal deze op van https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mollie - Payment processing
# Haal API keys op van: admin.bikerfun.nl/wp-admin → WooCommerce → Settings → Payments → Mollie
MOLLIE_API_KEY=your_mollie_live_api_key
# Optional: Voor testen
# MOLLIE_TEST_API_KEY=your_mollie_test_api_key

# WooCommerce - REST API credentials
# Genereer keys: admin.bikerfun.nl/wp-admin → WooCommerce → Settings → Advanced → REST API
NEXT_PUBLIC_WOOCOMMERCE_URL=https://admin.bikerfun.nl
WOOCOMMERCE_CONSUMER_KEY=your_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_woocommerce_consumer_secret

# Resend - Email service
# Zie EMAIL_SETUP.md voor gedetailleerde instructies
# Maak account aan op https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@bikerfun.nl
RESEND_TO_EMAIL=info@bikerfun.nl

# App URL - Voor lokaal: http://localhost:3000, Voor productie: https://bikerfun.nl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics (optioneel)
# Maak account aan op https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id
