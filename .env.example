# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mollie
MOLLIE_API_KEY=your-mollie-api-key

# WooCommerce
NEXT_PUBLIC_WOOCOMMERCE_URL=https://admin.bikerfun.nl
WOOCOMMERCE_CONSUMER_KEY=your-woocommerce-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-woocommerce-consumer-secret

# App URL
NEXT_PUBLIC_APP_URL=https://bikerfun.nl

# StackMail SMTP (Email) — Next.js app gebruikt Nodemailer (geen Resend). Alle vijf onderaan zijn verplicht om te verzenden.
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bikerfun.nl
SMTP_PASSWORD=your-email-password
# Afzender (meestal het mailbox-account waar je mee inlogt op SMTP)
SMTP_FROM_EMAIL=info@bikerfun.nl
# Inbox voor contact-/motorformulieren en standaard voor admin bij betaalde order
SMTP_TO_EMAIL=info@bikerfun.nl

# Optioneel: extra ontvangers voor "bestelling betaald" (komma-gescheiden). Anders alleen SMTP_TO_EMAIL.
# SMTP_ADMIN_ORDER_EMAILS=info@bikerfun.nl,nogiemand@voorbeeld.nl

# ─── Vercel: zet minimaal alle SMTP_* hierboven + Supabase + Mollie + NEXT_PUBLIC_APP_URL.
# Na wijziging env vars: Redeploy. Preview branches hebben eigen env als je die niet kopieert.

# Optioneel e-mailgedrag (default = aan/true):
# CONTACT_FORM_AUTOREPLY=false          # geen bevestiging naar klant na contactformulier
# MOTOR_FORMS_AUTOREPLY=false          # geen bevestiging naar klant na motor-op-aanvraag
# ADMIN_ORDER_PAID_NOTIFICATION=false   # geen beheerdersmail bij betaalde webshoporder

# Vercel Cron Security
CRON_SECRET=generate-random-string-here

# Upstash Redis (Optional - voor rate limiting)
# Als je rate limiting wilt activeren, maak een gratis account op https://upstash.com
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
